NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bovato?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Redis — In-memory cache & session store
REDIS_URL=redis://localhost:6379

# Shiprocket Integration
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_PINCODE=110001

# Meta WhatsApp Cloud API Integration
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_VERIFY_TOKEN=bovato_whatsapp_verify_token_2026
META_VERIFY_TOKEN=bovato_whatsapp_verify_token_2026
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_URL=http://localhost:5001/api/whatsapp/webhook

